[Unit]
Description=Fantasy football waiver check (Ludopathy Bowl, Hell or Highwater)
# Persistent=true fires this the instant a sleeping machine wakes, which is
# routinely before the network is up. Without this the first ESPN call fails
# and the check reports an outage as an expired cookie.
After=network-online.target
Wants=network-online.target
Documentation=file:///home/vinci/nfl_predict/scripts/waiver_check.sh

[Service]
Type=oneshot
WorkingDirectory=/home/vinci/nfl_predict
ExecStart=/home/vinci/nfl_predict/scripts/waiver_check.sh
# The script shells out to uv, which cron-like environments do not have on PATH.
Environment=PATH=/home/vinci/.local/bin:/home/vinci/.cargo/bin:/usr/local/bin:/usr/bin:/bin
