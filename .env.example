# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Live draft sync ────────────────────────────────────────────────────────
# Powers the Sync button in the draft UI and `nfl-predict nfl-sync`.
# ESPN is the only supported provider (NFL.com Fantasy moved to ESPN for
# the 2026 season).

# ESPN (required)
# League ID is the number in your league URL:
#   fantasy.espn.com/football/league?leagueId=XXXXXXX
# ESPN_S2 and ESPN_SWID are only needed for PRIVATE leagues — copy them from
# a logged-in browser (DevTools -> Application -> Cookies -> fantasy.espn.com).
# They expire, so expect to refresh them before draft day.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ESPN_TEAM_ID=
ESPN_SEASON=
