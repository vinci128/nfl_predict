# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Leagues ────────────────────────────────────────────────────────────────
# Both leagues' ESPN ids, team slots and sizes are already in the league
# profile (src/nfl_predict/leagues.py) — run `nfl-predict leagues` to see them.
# Nothing in this file is needed to build a draft board.
#
# Pin one league for a whole shell instead of passing --league every time:
NFL_PREDICT_LEAGUE=

# ── Live draft sync ────────────────────────────────────────────────────────
# Powers the Sync button in the draft UI and `nfl-predict nfl-sync`.
# ESPN is the only supported provider (NFL.com Fantasy moved to ESPN for
# the 2026 season).
#
# PRIVATE leagues only. Ludopathy Bowl is private and needs these; Hell or
# Highwater is public and needs nothing. Copy them from a logged-in browser
# (DevTools -> Application -> Cookies -> fantasy.espn.com). They expire, so
# expect to refresh them before draft day.
ESPN_S2=
ESPN_SWID=

# ── Overrides ──────────────────────────────────────────────────────────────
# Only set these to override what the league profile already knows.
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SEASON=
ESPN_LEAGUE_SIZE=
